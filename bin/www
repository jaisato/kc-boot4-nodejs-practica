#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('Nodepop:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Cluster configuration
 */
var cluster = require('cluster');

if (cluster.isPrimary) {
  // The rate limiters' counters live here, shared by every worker over IPC
  // (lib/rateLimitStore.js). Kept per worker, each one granted its own budget
  // and the login limit grew with the number of CPUs.
  var ClusterMemoryStorePrimary =
    require('@express-rate-limit/cluster-memory-store').ClusterMemoryStorePrimary;
  new ClusterMemoryStorePrimary().init();

  // Workers creation in primary...
  var numCPUs = require('os').cpus().length;

  for (var i = 0; i < numCPUs; i++) {
    cluster.fork();
  }

  // Nothing replaced a worker that died, so every crash permanently removed
  // capacity, and once the last one was gone the primary stayed up serving
  // nothing. A worker that had been serving is replaced. One that dies before
  // it ever listened (the port is taken, say) would only die again, so the
  // primary stops with an error instead of respawning it in a loop - or, as
  // before, idling with no workers at all.
  cluster.on('listening', function (worker) {
    worker.hasListened = true;
  });

  cluster.on('exit', function (worker, code, signal) {
    var reason = signal || code;

    if (worker.exitedAfterDisconnect) {
      return;
    }

    if (!worker.hasListened) {
      console.error('Worker ' + worker.process.pid + ' exited (' + reason +
        ') before it started listening; shutting down.');
      for (var id in cluster.workers) {
        cluster.workers[id].kill();
      }
      // exit() rather than exitCode: the primary also loaded the app, and its
      // open MongoDB connection would keep the process alive otherwise.
      process.exit(1);
    }

    console.error('Worker ' + worker.process.pid + ' died (' + reason + '); starting a new one.');
    cluster.fork();
  });

} else {
  // Worker starting...
  /**
   * Create HTTP server.
   */
  var server = http.createServer(app);

  /**
   * Listen on provided port, on all network interfaces.
   */
  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
}

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
