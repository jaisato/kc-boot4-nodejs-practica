#!/usr/bin/env node

/**
 * Module dependencies.
 */

var cluster = require('cluster');
var os = require('os');
var debug = require('debug')('Nodepop:server');

/**
 * How long a worker death is remembered when deciding whether the workers are
 * crashing in a loop (see superviseWorkers).
 */
var CRASH_WINDOW_MS = 60 * 1000;

/**
 * What a worker tells the primary once it has started (reportStarted).
 */
var STARTED = 'started';

/**
 * Get port from environment.
 */

var port = normalizePort(process.env.PORT || '3000');
var server;

/**
 * Refuse to start on a setting that is missing or wrong.
 *
 * The app does not load with one (lib/config.js), and only the workers load
 * the app. So it was each worker that found out, loading it, and died of it
 * with a stack trace, and the primary went on replacing them until it had
 * seen enough to give up: a trace per worker and one more, for something that
 * was known before the first of them was forked. It is said here instead,
 * once and in a line per setting, by whichever process this is: the primary,
 * which then forks nothing, or a worker that another cluster manager started.
 *
 * The settings and nothing else: whatever other reason the app has not to
 * load is still thrown where it is found.
 */
try {
  require('../lib/config');
} catch (err) {
  if (err.code !== 'ERR_NODEPOP_CONFIG') {
    throw err;
  }

  console.error(err.message);
  process.exit(1);
}

/**
 * Cluster configuration
 *
 * The primary only forks and supervises the workers. It used to require
 * ../app as well, before the fork, which opened a MongoDB connection pool in a
 * process that never serves a request - and made the primary die along with
 * every worker whenever that connection failed. The app is loaded by the
 * workers alone now.
 */
if (cluster.isPrimary) {
  // `cluster.isMaster` is the deprecated spelling of the same flag.
  var numWorkers = typeof os.availableParallelism === 'function'
    ? os.availableParallelism()
    : os.cpus().length;

  // No worker until the port is known to be there to listen on.
  whenPortIsFree(function () {
    // The login and sign-up limiters count in the primary, so their budget is
    // per client for the whole host and not per worker (lib/rateLimitStore.js).
    require('../lib/rateLimitStore').setupPrimary();

    cluster.on('fork', tolerateUndeliveredMessages);

    // Before the first fork: a stop that is asked for while the workers are
    // being forked has to find somebody listening for it already.
    superviseWorkers(numWorkers);

    for (var i = 0; i < numWorkers; i++) {
      cluster.fork();
    }
  });

} else {
  // Worker starting... It shares the counters only if the primary above is
  // what forked it; under another cluster manager it keeps its own.
  require('../lib/rateLimitStore').useSharedStore();

  var app = require('../app');
  var http = require('http');

  app.set('port', port);

  /**
   * Create HTTP server.
   */
  server = http.createServer(app);

  reportStarted();

  /**
   * Listen on provided port, on all network interfaces.
   */
  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
}

/**
 * Replaces workers that die.
 *
 * Nothing listened for a worker exiting, so every crash permanently took one
 * worker away. Once the last one was gone the primary was still running - so a
 * process supervisor saw a healthy process and restarted nothing - while no
 * worker was left to answer a single request.
 *
 * A worker that dies is forked again, unless forking again would only loop.
 * Then the primary stops (stopWorkers) and exits with code 1, and leaves the
 * restart to whatever supervises it. Two things tell it so:
 *
 * - More workers die within CRASH_WINDOW_MS than the cluster has. That is a
 *   burst, whatever the workers were doing: it also covers the worker that
 *   starts and dies at once, over and over.
 *
 * - More workers in a row than the cluster has die without having started,
 *   and none is up. That is a start that does not work (a wrong MONGODB_URI,
 *   database unreachable), however long each worker takes to fail at it. The
 *   minute above cannot see it when they take long: with no database a worker
 *   listens, waits for as long as serverSelectionTimeoutMS says and dies, and
 *   at a minute or more per round the deaths never added up - the primary
 *   went on replacing workers for ever, with nobody serving. Counted like
 *   this, it ends after two rounds.
 *
 *   Started is what the worker says it is (reportStarted): listening does not
 *   tell, because the worker with no database listens too. And "none is up"
 *   because a worker that is serving is worth more than a clean exit: if the
 *   database goes away with the cluster running, a worker that dies cannot be
 *   replaced until it is back, but the ones still there get their connection
 *   again on their own.
 *
 * It also stops when it is asked to, with SIGTERM or SIGINT. The primary used
 * to do nothing about those: the signal ended it on the spot and its workers
 * were left to find out. The ones that were up did, and went. The ones still
 * starting found out when they asked to listen, and each died with a `write
 * EPIPE` stack trace after the process that had been stopped was gone. Now it
 * stops them first (stopWorkers) and then ends by that same signal
 * (endBySignal): a stop that was asked for, not a failure.
 */
function superviseWorkers(numWorkers) {
  var recentCrashes = [];
  // The workers that have started and are still alive, by id.
  var up = {};
  // How many workers in a row have died without having started.
  var failedStarts = 0;
  // Given up, or asked to stop: no worker is replaced from then on.
  var stopping = false;

  ['SIGTERM', 'SIGINT'].forEach(function (signal) {
    // It goes on listening until endBySignal: a signal that came again with
    // nobody listening would end the primary half way through its workers.
    process.on(signal, function () {
      if (stopping) {
        return;
      }

      stopping = true;
      stopWorkers(function () {
        endBySignal(signal);
      });
    });
  });

  cluster.on('message', function (worker, message) {
    // A worker that said so with its last breath can be heard after its exit
    // has been dealt with: taken at its word it would be up for ever.
    if (message && message.nodepop === STARTED && !worker.isDead()) {
      up[worker.id] = true;
      failedStarts = 0;
      debug('Worker %d started', worker.process.pid);
    }
  });

  cluster.on('exit', function (worker, code, signal) {
    var hadStarted = up[worker.id] === true;

    delete up[worker.id];

    // A signal sent to the whole process group - Ctrl+C in a terminal - ends
    // the workers as well, and the death of one can be heard here before the
    // primary's own signal is. That is no worker to replace. So one that dies
    // of a signal the primary would stop for is not seen to there and then,
    // but once whatever came in with its death has been heard too.
    if (signal === 'SIGTERM' || signal === 'SIGINT') {
      setImmediate(replaceOrGiveUp, worker, code, signal, hadStarted);
      return;
    }

    replaceOrGiveUp(worker, code, signal, hadStarted);
  });

  function replaceOrGiveUp(worker, code, signal, hadStarted) {
    // Disconnected or killed by the primary itself: nothing to replace.
    if (stopping || worker.exitedAfterDisconnect) {
      return;
    }

    var now = Date.now();
    var reason = signal ? 'signal ' + signal : 'code ' + code;

    recentCrashes = recentCrashes.filter(function (at) {
      return now - at < CRASH_WINDOW_MS;
    });
    recentCrashes.push(now);

    if (!hadStarted) {
      failedStarts++;
    }

    if (failedStarts > numWorkers && Object.keys(up).length === 0) {
      console.error(
        'Worker %d exited (%s): %d workers in a row have failed to start and none is up, giving up.',
        worker.process.pid, reason, failedStarts
      );
      stopping = true;
      stopWorkers(exitWithFailure);
      return;
    }

    if (recentCrashes.length > numWorkers) {
      console.error(
        'Worker %d exited (%s): %d worker exits in the last %d s, giving up.',
        worker.process.pid, reason, recentCrashes.length, CRASH_WINDOW_MS / 1000
      );
      stopping = true;
      stopWorkers(exitWithFailure);
      return;
    }

    console.error(
      'Worker %d exited (%s), starting a replacement.',
      worker.process.pid, reason
    );
    cluster.fork();
  }
}

/**
 * Ends the cluster, once the primary has given up or been asked to stop:
 * stops the workers that are left and, when the last of them has gone, ends
 * the primary the way `end` does it.
 *
 * The primary used to end on the spot. The workers it had just forked were
 * still loading the app and found out on their own: each got as far as asking
 * to listen, tripped over the channel to a primary that was no longer there
 * and died with a `write EPIPE` stack trace - printed after the line that
 * said why the cluster was stopping, and looking like one more failure.
 *
 * SIGKILL: a worker that is still starting has nothing to finish, and one that
 * was serving was cut off just the same when the primary went from under it.
 */
function stopWorkers(end) {
  var alive = Object.keys(cluster.workers).filter(function (id) {
    return !cluster.workers[id].isDead();
  });

  function endWhenAlone() {
    if (alive.length === 0) {
      end();
    }
  }

  cluster.on('exit', function (worker) {
    alive = alive.filter(function (id) {
      return id !== String(worker.id);
    });
    endWhenAlone();
  });

  alive.forEach(function (id) {
    cluster.workers[id].process.kill('SIGKILL');
  });
  endWhenAlone();
}

/**
 * How the primary ends when it has given up: with exit code 1, for whatever
 * supervises it to start it again.
 */
function exitWithFailure() {
  process.exit(1);
}

/**
 * How the primary ends when it has been asked to stop: by the signal it was
 * asked with, sent to itself now that nobody listens for it, the way it would
 * have ended had nobody ever been. That is what tells whoever started it - a
 * shell, npm, systemd - that it was stopped and did not fail; a shell reports
 * it as 128 plus the signal's number, 143 for SIGTERM and 130 for SIGINT.
 *
 * The first process of a container (pid 1) is not sent the signals it does
 * not handle, its own included: there the signal does nothing, and the
 * primary exits with that same number instead.
 */
function endBySignal(signal) {
  process.removeAllListeners(signal);
  process.kill(process.pid, signal);
  process.exit(128 + os.constants.signals[signal]);
}

/**
 * Keeps a message that could not be delivered to a worker from ending the
 * primary.
 *
 * The primary answers its workers now (the rate-limit counters), and an answer
 * to a worker that has just died cannot be written. cluster reports that as an
 * 'error' event on the worker, and an 'error' event nobody listens for is an
 * uncaught exception: a worker dying with a question pending took the primary
 * down, and every other worker with it. The worker's own exit is what gets it
 * replaced (superviseWorkers), so all there is to do here is say so. Any other
 * error on a worker - it could not be spawned at all - stays as fatal as it
 * was.
 */
function tolerateUndeliveredMessages(worker) {
  worker.on('error', function (err) {
    var undelivered = err &&
      (err.syscall === 'write' || err.code === 'ERR_IPC_CHANNEL_CLOSED');

    if (!undelivered) {
      throw err;
    }

    // Killed by the primary itself (stopWorkers): that it was not there for
    // the answer to its last question is no news.
    if (worker.process.killed) {
      return;
    }

    console.error(
      'Worker %d: a message could not be delivered (%s).',
      worker.process.pid, err.code
    );
  });
}

/**
 * In a worker: tells the primary when this one has started, which is when it
 * is listening and has its connection to the database, whichever comes last.
 *
 * It is what the primary goes by to tell a worker that died from one that
 * never got going (superviseWorkers). Under another cluster manager the
 * message goes to a primary that makes nothing of it.
 */
function reportStarted() {
  var pending = 2;

  function one() {
    if (--pending > 0) {
      return;
    }

    process.send({nodepop: STARTED}, function (err) {
      // Not delivered means the primary is gone, and this worker with it.
      if (err) {
        debug('Could not tell the primary that this worker has started: %s', err.message);
      }
    });
  }

  server.once('listening', one);
  require('../lib/mongoConnection').once('open', one);
}

/**
 * Tries the port in the primary, before there is any worker.
 *
 * A port that is taken, or that takes privileges this process does not have,
 * is the same for every worker and no replacement is going to find it any
 * different. Each worker used to run into it on its own and die of it, and
 * the primary went on replacing them until it had seen enough to give up: the
 * reason came out once per worker, and one more time. Here it comes out once
 * (onError) and nothing is forked.
 *
 * The port could still be taken between this and the workers listening; they
 * report it then with the same words, one each.
 */
function whenPortIsFree(callback) {
  var probe = require('net').createServer();

  probe.once('error', onError);
  probe.once('listening', function () {
    probe.close(callback);
  });
  // close() waits for the connections there are: one that made it in while
  // the probe was listening would hold the start for as long as it stayed.
  probe.on('connection', function (socket) {
    socket.destroy();
  });
  probe.listen(port);
}

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 *
 * A worker does not listen itself: it asks the primary, and what comes back
 * when the port cannot be had is the primary's failed `bind`, not a `listen`.
 * Taken for an error of some other kind, it was thrown again and the worker
 * died with a stack trace instead of the line below.
 */

function onError(error) {
  if (error.syscall !== 'listen' && error.syscall !== 'bind') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
